# ── Claude / Anthropic ───────────────────────────────────────────────────────
ANTHROPIC_API_KEY=

# ── Base de datos (PostgreSQL) ───────────────────────────────────────────────
# Railway proporciona DATABASE_URL automáticamente al añadir un plugin de Postgres
POSTGRES_URL=postgresql://user:password@localhost:5432/carpinteria

# ── ChromaDB ─────────────────────────────────────────────────────────────────
# Para Railway: monta un volumen en /app/chroma_data o usa un servicio ChromaDB externo
CHROMA_PERSIST_PATH=./chroma_data
# CHROMA_HOST=         # Si usas ChromaDB como servicio HTTP separado
# CHROMA_PORT=8000

# ── Integraciones externas ───────────────────────────────────────────────────
HOLDED_API_KEY=
N8N_WEBHOOK_URL=
SLACK_WEBHOOK_URL=

# ── Seguridad JWT ────────────────────────────────────────────────────────────
# IMPORTANTE: cambia esto en producción por un valor aleatorio largo
JWT_SECRET=cambia-esto-en-produccion

# ── CORS ─────────────────────────────────────────────────────────────────────
# Lista de orígenes permitidos separados por coma. Usa * para permitir todos (solo dev).
# Ejemplo producción: https://tu-frontend.up.railway.app
CORS_ORIGINS=*

# ── Uploads ──────────────────────────────────────────────────────────────────
# Directorio local temporal (el vision agent siempre lee desde aquí durante el proceso).
UPLOAD_DIR=/app/uploads

# ── Almacenamiento en la nube (Cloudflare R2 / AWS S3) ───────────────────────
# Si estas variables están presentes los archivos se suben al bucket además del disco local.
# Sin ellas el sistema usa solo el disco local (válido para desarrollo).
#
# Pasos para Cloudflare R2:
#   1. cloudflare.com → R2 → Create bucket  (nombre ej: carpinteria-ai-uploads)
#   2. Bucket → Settings → Public access → Allow
#   3. cloudflare.com → My Profile → API Tokens → Create Token
#      → Permissions: R2 Object Read & Write → copiar Account ID, Key ID y Secret
#
# S3_BUCKET_NAME=carpinteria-ai-uploads
# S3_ENDPOINT_URL=https://<ACCOUNT_ID>.r2.cloudflarestorage.com
# S3_ACCESS_KEY_ID=<R2_ACCESS_KEY_ID>
# S3_SECRET_ACCESS_KEY=<R2_SECRET_ACCESS_KEY>
# S3_REGION=auto
# S3_PUBLIC_URL=https://pub-<TOKEN>.r2.dev   # URL pública del bucket (o dominio propio)
