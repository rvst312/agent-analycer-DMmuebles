# ── Claude / Anthropic ───────────────────────────────────────────────────────
ANTHROPIC_API_KEY=

# ── Base de datos (PostgreSQL) ───────────────────────────────────────────────
# Railway proporciona DATABASE_URL automáticamente al añadir un plugin de Postgres
POSTGRES_URL=postgresql://user:password@localhost:5432/carpinteria

# ── ChromaDB ─────────────────────────────────────────────────────────────────
# Para Railway: monta un volumen en /app/chroma_data o usa un servicio ChromaDB externo
CHROMA_PERSIST_PATH=./chroma_data
# CHROMA_HOST=         # Si usas ChromaDB como servicio HTTP separado
# CHROMA_PORT=8000

# ── Integraciones externas ───────────────────────────────────────────────────
HOLDED_API_KEY=
N8N_WEBHOOK_URL=
SLACK_WEBHOOK_URL=

# ── Seguridad JWT ────────────────────────────────────────────────────────────
# IMPORTANTE: cambia esto en producción por un valor aleatorio largo
JWT_SECRET=cambia-esto-en-produccion

# ── CORS ─────────────────────────────────────────────────────────────────────
# Lista de orígenes permitidos separados por coma. Usa * para permitir todos (solo dev).
# Ejemplo producción: https://tu-frontend.up.railway.app
CORS_ORIGINS=*

# ── Uploads ──────────────────────────────────────────────────────────────────
UPLOAD_DIR=/app/uploads
